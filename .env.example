# Local Kafka broker exposed by docker compose
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_TOPIC=transaction-events
KAFKA_GROUP_ID=ai-event-pipeline-v1
SQLITE_PATH=data/events.sqlite
MODEL_PATH=models/anomaly_detector.joblib
SINK=sqlite

# Set SINK=snowflake only after provisioning Snowflake and applying sql/setup.sql
# SNOWFLAKE_ACCOUNT=your-org-your-account
# SNOWFLAKE_USER=your-user
# SNOWFLAKE_PASSWORD=never-commit-secrets
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# SNOWFLAKE_DATABASE=EVENT_ANALYTICS
# SNOWFLAKE_SCHEMA=RAW
# SNOWFLAKE_ROLE=SYSADMIN
# AWS Lambda (optional): SNOWFLAKE_SECRET_ARN holds JSON with Snowflake credentials

# Optional GenAI incident narrative (requires `pip install -e '.[llm]'`)
# OPENAI_API_KEY=never-commit-keys
# OPENAI_MODEL=gpt-4.1-mini
